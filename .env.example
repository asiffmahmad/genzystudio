# ============================================================
# GenzyStudio - Required Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ============================================================

NODE_ENV=production

# ---- App URLs (update for your domain) --------------------
NEXT_PUBLIC_APP_URL=https://genzystudio.asiff.dev

# ---- Database (TiDB / MySQL / PostgreSQL) -----------------
DATABASE_URL="mysql://user:password@host:port/db?sslaccept=strict"

# ---- Security ---------------------------------------------
ENCRYPTION_KEY=                   # 32-char random string
SESSION_SECRET=                   # 32-char random string

# ---- Facebook OAuth (Login for Business) ------------------
# App ID: found in Meta Developer Console > Your App > Dashboard
META_FACEBOOK_APP_ID=1093388120314319
# App Secret: found in Meta Developer Console > Your App > Settings > Basic
META_FACEBOOK_APP_SECRET=         # KEEP SECRET - never expose to frontend
# Must exactly match what you register in: Meta App > Facebook Login > Valid OAuth Redirect URIs
META_FACEBOOK_REDIRECT_URI=https://genzystudio.asiff.dev/api/oauth/facebook/callback
META_FACEBOOK_SCOPES=pages_show_list,pages_manage_posts

# ---- Instagram OAuth (Login for Business) -----------------
# App ID: found in Meta Developer Console > Your Instagram App > Dashboard
META_INSTAGRAM_APP_ID=2625527471233152
# App Secret: found in Meta Developer Console > Your Instagram App > Settings > Basic
META_INSTAGRAM_APP_SECRET=        # KEEP SECRET - never expose to frontend
# Must exactly match what you register in: Meta App > Instagram > Valid OAuth Redirect URIs
META_INSTAGRAM_REDIRECT_URI=https://genzystudio.asiff.dev/api/oauth/instagram/callback
META_INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
# Used to validate incoming webhooks from Meta
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=55955e5ce2b48ebc70b77fffc9e56442fb79ad7a691d2737138ead9697be9e01

# ---- LinkedIn OAuth (optional) ----------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://genzystudio.asiff.dev/api/oauth/linkedin/callback

# ---- X (Twitter) OAuth 2.0 --------------------------------
# Client ID: found in X Developer Portal > Your App > Keys and tokens
X_CLIENT_ID=
# Client Secret: found in X Developer Portal > Your App > Keys and tokens
X_CLIENT_SECRET=                  # KEEP SECRET - never expose to frontend
# Must exactly match what you register in: X Developer Portal > User authentication settings > Callback URI
X_REDIRECT_URI=https://genzystudio.asiff.dev/api/oauth/x/callback

# ---- AI Integration (Groq) --------------------------------
GROQ_API_KEY=                     # Get from console.groq.com

# ---- Feature Flags ----------------------------------------
SOCIAL_PROVIDER_MODE=real         # "real" or "mock"
CRON_SECRET=                      # Random string to protect /api/cron endpoints
